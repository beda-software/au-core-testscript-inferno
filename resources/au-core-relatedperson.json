      "description": "Read RelatedPerson by id (${relatedPersonId})"
    },
    {
      "name": "ProfileValidation",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "read"
            },
            "resource": "RelatedPerson",
            "params": "/${relatedPersonId}",
            "encodeRequestUrl": true,
            "description": "Read RelatedPerson by id (${relatedPersonId})"
          }
        },
        {
          "assert": {
            "validateProfileId": "http://hl7.org.au/fhir/core/StructureDefinition/au-core-relatedperson",
            "warningOnly": false,
            "description": "Validate the response against profile http://hl7.org.au/fhir/core/StructureDefinition/au-core-relatedperson"
          }
        }
      ],
      "description": "Read RelatedPerson by id (${relatedPersonId})"
    }
  ]
