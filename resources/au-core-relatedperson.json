            "description": "Check: Bundle.entry.resource.ofType(RelatedPerson).relationship.coding.code.where($this = 'FTH').exists()"
          }
        }
      ],
      "description": "Search RelatedPerson where relationship = http://terminology.hl7.org/CodeSystem/v3-RoleCode|FTH"
    },
    {
