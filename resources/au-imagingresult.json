              "code": "read"
            },
            "resource": "Observation",
            "params": "/${imagingResultId}",
            "encodeRequestUrl": true,
            "description": "Read Observation by id (${imagingResultId})"
          }
        },
        {
          "assert": {
            "response": "okay",
            "warningOnly": false,
            "description": "Response status is okay"
          }
        }
      ],
      "description": "Read Observation by id (${imagingResultId})"
    },
    {
